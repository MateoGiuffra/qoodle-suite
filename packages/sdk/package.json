{
  "name": "qoodle-sdk",
  "version": "1.0.0",
  "description": "SDK para loguearse por SAML y leer contenido de Qoodle (Moodle UVQ): cursos, foros, recursos y tareas. Sin dependencias de Express ni del SDK de MCP.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateoGiuffra/qoodle-suite.git",
    "directory": "packages/sdk"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "axios-cookiejar-support": "^6.0.5",
    "cheerio": "^1.2.0",
    "pdf-parse": "^2.4.5",
    "tough-cookie": "^6.0.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
